# Auto-detect text files
* text=auto

# Rust sources
*.rs text eol=lf
*.toml text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Config files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Markdown
*.md text eol=lf

# Lock files
Cargo.lock text eol=lf

# Binary files
*.exe binary
*.dll binary
